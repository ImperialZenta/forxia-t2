# Copy to .env.local for local development
# Set these in Vercel → Project → Settings → Environment Variables for production

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form — where submissions are delivered
CONTACT_EMAIL=andrew@forxia.com

# Resend (https://resend.com) — free tier available
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified domain in Resend, or use onboarding@resend.dev for testing
EMAIL_FROM="Forxia Coaching and Consulting <hello@forxia.com>"

# Optional: Calendly link shown on contact page
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Stripe — https://dashboard.stripe.com/apikeys
# Create all prices in CAD (Canadian dollars)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Stripe Price IDs — create Products/Prices in Stripe Dashboard (currency: CAD)
# General 30 min Consultation Call (CA $150 one-time)
STRIPE_PRICE_CONSULTATION=price_xxxxxxxxxxxx
# Foundation Assessment (CA $2,500 one-time)
STRIPE_PRICE_FOUNDATION=price_xxxxxxxxxxxx
# Growth Retainer (CA $4,500/month subscription)
STRIPE_PRICE_RETAINER=price_xxxxxxxxxxxx
