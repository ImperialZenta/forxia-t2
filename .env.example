# Copy to .env.local for local development
# Set these in Vercel → Project → Settings → Environment Variables for production

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# Contact form — Workspace inbox that receives submissions (not shown on the site)
CONTACT_EMAIL=andrew@forxia.com

# Resend (https://resend.com) — send-only API; free tier is enough for low volume
# Verify forxia.com in Resend, or use onboarding@resend.dev for testing only
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Forxia Coaching and Consulting <hello@forxia.com>"

# Optional: Calendly link shown on contact page
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Stripe — https://dashboard.stripe.com/apikeys
# Create all prices in CAD (Canadian dollars)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Stripe Price IDs — create Products/Prices in Stripe Dashboard (currency: CAD)
# General 30 min Consultation Call (CA $150 one-time)
STRIPE_PRICE_CONSULTATION=price_xxxxxxxxxxxx
